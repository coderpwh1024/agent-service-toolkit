[Unit]
Description=Agent Voice Server Streamlit UI
Wants=network-online.target agent-service.service
After=network-online.target agent-service.service

[Service]
Type=simple
User=agent-service
Group=agent-service
WorkingDirectory=/opt/agent-voice-server
ExecStart=/opt/agent-voice-server/.venv/bin/python /opt/agent-voice-server/deploy/run.py app
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
