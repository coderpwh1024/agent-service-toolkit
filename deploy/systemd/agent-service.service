[Unit]
Description=Agent Voice Server API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agent-service
Group=agent-service
WorkingDirectory=/opt/agent-voice-server
ExecStart=/opt/agent-voice-server/.venv/bin/python /opt/agent-voice-server/deploy/run.py service
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
