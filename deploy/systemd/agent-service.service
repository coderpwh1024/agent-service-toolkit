[Unit]
Description=Agent Service Toolkit API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agent-service
Group=agent-service
WorkingDirectory=/opt/agent-service-toolkit
ExecStart=/opt/agent-service-toolkit/.venv/bin/python /opt/agent-service-toolkit/deploy/run.py service
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
