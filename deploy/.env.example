APP_ENV=local
MODE=prod
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
GRACEFUL_SHUTDOWN_TIMEOUT=30

NACOS_ENABLED=false
NACOS_REGISTER_SERVICE=false

AUTH_SECRET=replace-with-a-long-random-service-secret
DASHSCOPE_API_KEY=replace-with-your-bailian-api-key

DATABASE_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agent_service
POSTGRES_USER=agent_service
POSTGRES_PASSWORD=replace-with-your-database-password

EMAIL_AUTH_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
VOICE_ENABLED=false

AGENT_URL=http://127.0.0.1:8000
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional HappyHorse video API; see docs/Video_API.md.
VIDEO_ENABLED=false
VIDEO_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_SKILL_ENABLED=false
VIDEO_SKILL_LABEL=latest
VIDEO_SKILL_TIMEOUT_SECONDS=20
# APP_TOKEN_SECRET=replace-with-at-least-32-random-characters
# QINIU_ACCESS_KEY=replace-with-qiniu-access-key
# QINIU_SECRET_KEY=replace-with-qiniu-secret-key
# QINIU_BUCKET_NAME=replace-with-bucket-name
# QINIU_PUBLIC_BASE_URL=https://cdn.example.com
