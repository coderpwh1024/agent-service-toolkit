# This file contains only the bootstrap settings needed to reach Nacos. Application,
# model, authentication, storage, email, RAG, and voice settings belong in the Nacos
# configuration whose Data ID is agent-service-toolkit.yaml.
# Nacos 3.x clients use the server port (8848 by default) and gRPC port (9848), not
# the console port (commonly 8080).
NACOS_ENABLED=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_CONTEXT_PATH=/nacos
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=replace-with-nacos-password
NACOS_NAMESPACE_ID=
NACOS_GROUP_NAME=DEFAULT_GROUP
# YAML configuration loaded before application resources are initialized.
NACOS_CONFIG_DATA_ID=agent-service-toolkit.yaml
NACOS_STORAGE_CONFIG_REQUIRED=true
NACOS_REGISTER_SERVICE=true
NACOS_SERVICE_NAME=agent-service-toolkit
# Set an address reachable by consumers; automatic detection is used when omitted.
# NACOS_SERVICE_IP=127.0.0.1
# NACOS_SERVICE_PORT=8080
NACOS_CLUSTER_NAME=DEFAULT
NACOS_METADATA={}
NACOS_GRPC_PORT_OFFSET=1000
# NACOS_CACHE_DIR=/tmp/agent-service-toolkit/nacos/cache
# NACOS_LOG_DIR=/tmp/agent-service-toolkit/nacos/logs
