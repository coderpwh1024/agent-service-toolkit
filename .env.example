# Select config/environments/local.env or config/environments/test.env.
APP_ENV=local

# Change this when the local Nacos console already occupies host port 8080.
AGENT_HOST_PORT=8000
AGENT_URL=http://127.0.0.1:8000

# Keep environment-specific secrets in the ignored .env.local or .env.test file.
# Non-secret Nacos bootstrap settings are maintained in config/environments/*.env.

# Mem0 application settings belong in Nacos: memory.mem0 (see docs/Mem0_Memory.md).
# Web research defaults on; no search API key is required. Nacos: memory.mem0.research.
# MEM0_RESEARCH_ENABLED=true
# MEM0_RESEARCH_TIMEOUT_SECONDS=20
# MEM0_RESEARCH_FINAL_TIMEOUT_SECONDS=15
# RESEARCH_SEARCH_TIMEOUT_SECONDS=5
# Optional explicit prefix caching: Nacos models.dashscope.explicit_cache_enabled (default false).
# DASHSCOPE_EXPLICIT_CACHE_ENABLED=false
# Mem0 prompts are published separately in Nacos AI Prompt management; no local defaults.
# Optional references: memory.mem0.prompt_keys and prompt_label (default: latest).
# Mem0 reranking: memory.mem0.rerank_model, rerank_url, rerank_candidates, rerank_timeout_seconds.
# When Nacos is disabled, configure MEM0_ENABLED and the documented MEM0_* fields.
# Normal HTTP chat: Nacos models.chat.enable_thinking (default false); request agent_config.enable_thinking overrides.
# CHAT_LLM_ENABLE_THINKING=false
# Voice chat thinking: Nacos voice.llm.enable_thinking (default false).
# When Nacos is disabled, use VOICE_LLM_ENABLE_THINKING=true to opt in.
# Speech protocol and per-model voices: Nacos voice.realtime (docs/Voice_API.md).
# Current-user email skill: Nacos skills.email (docs/Email_Skill.md), disabled by default.
# Delivery time zone: Nacos skills.email.timezone (default Asia/Shanghai).
# SMTP credentials stay in Nacos authentication.email.smtp; never in a skill package.
# Same-protocol model snapshots use automatic routing; unknown families need an explicit protocol.
# VOICE_REALTIME_STT_PROTOCOL=auto
# VOICE_REALTIME_TTS_PROTOCOL=auto
# VOICE_REALTIME_STT_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# VOICE_REALTIME_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# VOICE_REALTIME_VOICES_MODEL=my-tts-model
# VOICE_REALTIME_VOICE_CATALOG={"my-tts-model":[{"id":"my-voice","name":"自定义音色","languages":["zh"]}]}
# Wake phrase: Nacos voice.wake.word (default 小美小美), pre_roll_ms: 4000.
# Nacos voice.wake.greeting and confirm_seconds customize the wake response.
# KWS defaults: kws_score: 1.5, kws_threshold: 0.25; keep ASR double-call confirmation.
# Without Nacos: VOICE_WAKE_WORD=小美小美, VOICE_WAKE_PRE_ROLL_MS=4000,
# VOICE_WAKE_GREETING=我在，小美随时为你服务。, VOICE_WAKE_CONFIRM_SECONDS=10.
# Logging is bootstrap configuration, outside Nacos.
LOG_FORMAT=json
# LOG_LEVEL=INFO

# HappyHorse / Wan 3.0 video generation (docs/Video_API.md); use app user tokens.
VIDEO_ENABLED=false
VIDEO_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Nacos-managed runtime video skill, independent of the existing HTTP endpoints.
VIDEO_SKILL_ENABLED=false
VIDEO_SKILL_LABEL=latest
# VIDEO_SKILL_VERSION=replace-with-published-version
VIDEO_SKILL_TIMEOUT_SECONDS=20
# Use the matching region's API key; secrets belong in the ignored environment override.
# DASHSCOPE_API_KEY=replace-with-bailian-api-key
# AUTH_SECRET=replace-with-trusted-service-secret
# APP_TOKEN_SECRET=replace-with-at-least-32-random-characters
# AUTH_SERVICE_ACCOUNT_ID=0
# Reuses the existing Qiniu storage configuration (also used for avatars).
# QINIU_ACCESS_KEY=replace-with-qiniu-access-key
# QINIU_SECRET_KEY=replace-with-qiniu-secret-key
# QINIU_BUCKET_NAME=replace-with-bucket-name
# QINIU_PUBLIC_BASE_URL=https://cdn.example.com
# FILE_UPLOAD_ENABLED=false
# FILE_UPLOAD_MAX_BYTES=20971520
# Enable Chinese request/response summaries with LOG_LEVEL=INFO.
