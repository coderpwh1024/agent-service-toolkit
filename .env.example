# Set at least one model provider key, or export it in your shell.
# DASHSCOPE_API_KEY=your-api-key

# AUTH_SECRET is an optional trusted-admin credential. Nacos supplies APP_TOKEN_SECRET.
VOICE_ENABLED=false
# AUTH_SECRET=replace-with-a-long-random-service-secret
APP_TOKEN_TTL_SECONDS=3600

# Passwordless email login and registration. Nacos supplies Redis and SMTP settings.
# New users receive a default nickname derived from their email address. Redis enforces
# six sends per rolling 24 hours and a three-minute code TTL.
EMAIL_AUTH_ENABLED=false
AUTH_SERVICE_ACCOUNT_ID=0

VOICE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# Optional explicit proxy URL. Empty means connect to DashScope directly.
# VOICE_REALTIME_PROXY=http://proxy.example:8080
VOICE_REALTIME_STT_MODEL=qwen3-asr-flash-realtime
VOICE_REALTIME_TTS_MODEL=qwen3-tts-flash-realtime
VOICE_REALTIME_VOICES=["Cherry"]
VOICE_MAX_SESSIONS=8
VOICE_SESSION_SECONDS=1800
VOICE_IDLE_SECONDS=120
VOICE_QUEUE_SIZE=64
VOICE_VAD_SILENCE_MS=500
VOICE_VAD_THRESHOLD=0.2

# PostgreSQL is required for short-term and long-term memory. When enabled, Nacos supplies
# its connection settings from the configuration identified below.
DATABASE_TYPE=postgres

# Nacos 3.x integration. The Nacos 3 console commonly uses port 8080, while SDK
# clients connect to the server port (8848 by default) and gRPC port (9848).
NACOS_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_CONTEXT_PATH=/nacos
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=replace-with-nacos-password
NACOS_NAMESPACE_ID=
NACOS_GROUP_NAME=DEFAULT_GROUP
# YAML configuration loaded before PostgreSQL and Redis are initialized.
NACOS_CONFIG_DATA_ID=agent-service-toolkit.yaml
NACOS_STORAGE_CONFIG_REQUIRED=true
NACOS_REGISTER_SERVICE=true
NACOS_SERVICE_NAME=agent-service-toolkit
# Set an address reachable by consumers; automatic detection is used when omitted.
# NACOS_SERVICE_IP=127.0.0.1
# NACOS_SERVICE_PORT=8080
NACOS_CLUSTER_NAME=DEFAULT
NACOS_METADATA={}
NACOS_GRPC_PORT_OFFSET=1000
# NACOS_CACHE_DIR=/tmp/agent-service-toolkit/nacos/cache
# NACOS_LOG_DIR=/tmp/agent-service-toolkit/nacos/logs
