# Set at least one model provider key, or export it in your shell.
# DASHSCOPE_API_KEY=your-api-key

# Enable the mobile realtime voice API. Keep both secrets on the backend.
# AUTH_SECRET is used only by a trusted login/provisioning service to issue app tokens.
# APP_TOKEN_SECRET signs short-lived per-user tokens and must be at least 32 characters.
VOICE_ENABLED=false
# AUTH_SECRET=replace-with-a-long-random-service-secret
# APP_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_TOKEN_TTL_SECONDS=3600
VOICE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# Optional explicit proxy URL. Empty means connect to DashScope directly.
# VOICE_REALTIME_PROXY=http://proxy.example:8080
VOICE_REALTIME_STT_MODEL=qwen3-asr-flash-realtime
VOICE_REALTIME_TTS_MODEL=qwen3-tts-flash-realtime
VOICE_REALTIME_VOICES=["Cherry"]
VOICE_MAX_SESSIONS=8
VOICE_SESSION_SECONDS=1800
VOICE_IDLE_SECONDS=120
VOICE_QUEUE_SIZE=64
VOICE_VAD_SILENCE_MS=500
VOICE_VAD_THRESHOLD=0.2

# PostgreSQL is required for both short-term and long-term memory.
# These local defaults match `docker compose up -d postgres`.
# Docker Compose overrides POSTGRES_HOST to postgres inside the service container.
DATABASE_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agent_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
